# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database Connection (Optional in DEMO_MODE, recommended for production)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/mentorconnect?retryWrites=true&w=majority"

# JWT Secret for signing auth tokens
JWT_SECRET="mentor_connect_super_secret_jwt_key_rethink26"

# Cloudinary Storage for mentor verification documents & avatars (optional)
CLOUDINARY_CLOUD_NAME="demo-mentorconnect"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_secret"

# Client and Server URLs
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# DEMO_MODE enables instant seed data and high-resilience presentation mode
DEMO_MODE=true
